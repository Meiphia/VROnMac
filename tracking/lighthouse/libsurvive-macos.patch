+// VRConMac: empty payloads have CRC zero, but are not station calibration.
+bool ootx_decode_v15_checked(const ootx_packet *packet, lighthouse_info_v15 *out) {
+    if (!packet || !out || !packet->data || packet->length < 43) return false;
+    init_lighthouse_info_v15(out, packet->data);
+    if (!out->id || out->id == UINT32_MAX || (out->mode_current & 0x7f) >= 16) return false;
+    for (int axis=0;axis<2;++axis) {
+        if (!isfinite(out->fcal_phase[axis]) || !isfinite(out->fcal_tilt[axis]) ||
+            !isfinite(out->fcal_curve[axis]) || !isfinite(out->fcal_gibphase[axis]) ||
+            !isfinite(out->fcal_gibmag[axis]) || !isfinite(out->fcal_ogeephase[axis]) ||
+            !isfinite(out->fcal_ogeemag[axis])) return false;
+    }
+    return true;
+}
