+// VRConMac: macOS does not implement unnamed POSIX semaphores.
+#ifdef __APPLE__
+typedef struct {
+    pthread_mutex_t mutex;
+    pthread_cond_t changed;
+    unsigned count;
+} OGMacSemaphore;
+OSG_INLINE og_sema_t OGCreateSema() {
+    OGMacSemaphore *s = (OGMacSemaphore *)calloc(1, sizeof(*s));
+    if (!s) abort();
+    _OGHandlePosixError("semaphore mutex", pthread_mutex_init(&s->mutex, NULL));
+    _OGHandlePosixError("semaphore condition", pthread_cond_init(&s->changed, NULL));
+    return (og_sema_t)s;
+}
+OSG_INLINE int OGGetSema(og_sema_t os) {
+    OGMacSemaphore *s = (OGMacSemaphore *)os;
+    pthread_mutex_lock(&s->mutex);
+    int count = (int)s->count;
+    pthread_mutex_unlock(&s->mutex);
+    return count;
+}
+OSG_INLINE void OGLockSema(og_sema_t os) {
+    OGMacSemaphore *s = (OGMacSemaphore *)os;
+    pthread_mutex_lock(&s->mutex);
+    while (!s->count) pthread_cond_wait(&s->changed, &s->mutex);
+    --s->count;
+    pthread_mutex_unlock(&s->mutex);
+}
+OSG_INLINE void OGUnlockSema(og_sema_t os) {
+    OGMacSemaphore *s = (OGMacSemaphore *)os;
+    pthread_mutex_lock(&s->mutex);
+    ++s->count;
+    pthread_cond_signal(&s->changed);
+    pthread_mutex_unlock(&s->mutex);
+}
+OSG_INLINE void OGDeleteSema(og_sema_t os) {
+    OGMacSemaphore *s = (OGMacSemaphore *)os;
+    pthread_cond_destroy(&s->changed);
+    pthread_mutex_destroy(&s->mutex);
+    free(s);
+}
+#else
 OSG_INLINE og_sema_t OGCreateSema() {
 	sem_t *sem = (sem_t *)malloc(sizeof(sem_t));
 	sem_init(sem, 0, 0);
@@ -164,6 +206,8 @@
 	sem_destroy((sem_t *)os);
 	free(os);
 }
+
+#endif
 
