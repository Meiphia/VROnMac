--- /dev/null
+++ b/virglrenderer/src/neptune/npt_resource_limits.h
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NPT_RESOURCE_LIMITS_H
+#define NPT_RESOURCE_LIMITS_H
+#include <stdbool.h>
+#include <stdint.h>
+/* Bounded per-call upload, large enough for legitimate avatar/texture buffers.
+ * Keep the cap far below UINT32_MAX so alignment cannot overflow. */
+#define NPT_MAX_RESOURCE_UPDATE_BYTES (256u << 20)
+#if NPT_MAX_RESOURCE_UPDATE_BYTES > UINT32_MAX - 7u
+#error Resource upload cap must leave room for 8-byte alignment
+#endif
+static inline bool
+npt_resource_update_payload_size(uint32_t byte_size, uint32_t *aligned)
+{
+   if (byte_size > NPT_MAX_RESOURCE_UPDATE_BYTES)
+      return false;
+   *aligned = (byte_size + 7u) & ~7u;
+   return true;
+}
+#endif
